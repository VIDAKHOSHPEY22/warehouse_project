# ---------------------------------------------------------------
# نمونه فایل تنظیمات محیطی. این فایل را کپی و به نام .env ذخیره کنید
# cp .env.example .env
# ---------------------------------------------------------------

# آدرس اتصال به دیتابیس PostgreSQL
DATABASE_URL=postgresql+psycopg2://warehouse_user:warehouse_pass@db:5432/warehouse_db

# کلید مخفی برای امضای توکن‌های JWT - حتما در محیط Production تغییر دهید
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# اطلاعات کاربر ادمین پیش‌فرض که هنگام seed ساخته می‌شود
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_FULLNAME=مدیر سیستم

# تنظیمات CORS - آدرس فرانت‌اند
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
